{
  "name": "wb-finds-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node miniapp/cloudflare/prepare-assets.mjs",
    "test:worker": "node --test miniapp/cloudflare/*.test.mjs",
    "test:shadow": "node --test miniapp/shadow/*.test.mjs",
    "test:features": "node --test miniapp/features/*.test.mjs",
    "features:preview": "node miniapp/features/preview_server.mjs",
    "check:features": "esbuild miniapp/features/worker.mjs --bundle --format=esm --platform=browser --outdir=.test-temp/feature-worker-build",
    "style:staging:prepare": "node miniapp/features/prepare_staging.mjs",
    "style:staging:check": "node miniapp/features/staging_tool.mjs",
    "shadow:gallery": "node miniapp/shadow/gallery_server.mjs",
    "shadow:report": "node miniapp/shadow/fashion_report.mjs",
    "shadow:budget-probe": "node miniapp/shadow/budget_probe.mjs",
    "shadow:taste-analysis": "node miniapp/shadow/taste_analysis.mjs",
    "shadow:prospective-photos": "node miniapp/shadow/prospective_report.mjs",
    "shadow:prospective-prepare": "node miniapp/shadow/prepare_prospective.mjs",
    "shadow:prospective-audit": "node miniapp/shadow/audit_prospective.mjs",
    "deploy": "npm run build && wrangler deploy",
    "check:deploy": "npm run build && wrangler deploy --dry-run --outdir .test-temp/worker-build"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "wrangler": "4.146.0"
  },
  "dependencies": {
    "@telegram-apps/telegram-ui": "2.1.13",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
