{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wb-finds-miniapp",
  "account_id": "a4f7cbd9ad379d4b18087b99e9839205",
  "main": "miniapp/cloudflare/worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": {"binding": "CF_VERSION"},
  "keep_vars": true,
  "send_metrics": false,
  "assets": {
    "directory": "miniapp/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "wb-finds-miniapp",
    "database_id": "d73d252d-3948-425b-b7c3-b65d0f5c6e5f"
  }],
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "1001",
    "simple": {"limit": 60, "period": 60}
  }],
  "triggers": {"crons": ["* * * * *"]},
  "observability": {"enabled": true}
}
